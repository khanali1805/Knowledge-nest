const fs = require("node:fs");
const path = require("node:path");
const ts = require("typescript");
const projectRoot = process.argv[2];
const tsconfigPath = path.join(projectRoot, "tsconfig.json");
const rawContent = fs.readFileSync(tsconfigPath, "utf8");
const parsed = ts.parseConfigFileTextToJson(
  tsconfigPath,
  rawContent,
);
if (parsed.error) {
  const message = ts.flattenDiagnosticMessageText(
    parsed.error.messageText,
    "\n",
  );
  throw new Error(message);
}
const config = parsed.config || {};
const permanentExclusions = [
  "node_modules",
  ".next",
  "dist",
  "build",
  "coverage",
  "backups",
  "backups/**/*",
  "logs",
  "logs/**/*",
  "phase-5b-backup",
  "phase-5b-backup/**/*",
  "**/*.backup.ts",
  "**/*.backup.tsx",
  "**/*.bak.ts",
  "**/*.bak.tsx"
];
const existingExclusions = Array.isArray(config.exclude)
  ? config.exclude
  : [];
config.exclude = Array.from(
  new Set([
    ...existingExclusions,
    ...permanentExclusions,
  ]),
);
fs.writeFileSync(
  tsconfigPath,
  `${JSON.stringify(config, null, 2)}\n`,
  "utf8",
);
console.log("tsconfig.json updated successfully.");
