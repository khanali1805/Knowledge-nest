            $SidebarContent = $SidebarContent.Remove(
                $ThemeItemMatch.Index,
                $ThemeItemMatch.Length
            ).Insert(
                $ThemeItemMatch.Index,
                $ThemeItemReplacement
            )
        }
    }
    if (
        $SidebarContent -match `
        'from\s+["'']lucide-react["'']' -and
        $SidebarContent -notmatch `
        '(?s)import\s*\{[^}]*\bPalette\b[^}]*\}\s*from\s*["'']lucide-react["'']'
    ) {
        $LucideImportRegex = [regex]::new(
            '(?s)import\s*\{(?<imports>[^}]*)\}\s*from\s*["'']lucide-react["''];?'
        )
        $LucideMatch = $LucideImportRegex.Match($SidebarContent)
        if (-not $LucideMatch.Success) {
            throw "Lucide icon import block was not found."
        }
        $CurrentImports = $LucideMatch.Groups["imports"].Value.Trim()
        $NewImport = @"
import {
  $CurrentImports,
  Palette,
} from "lucide-react";
"@
        $SidebarContent = $SidebarContent.Remove(
            $LucideMatch.Index,
            $LucideMatch.Length
        ).Insert(
            $LucideMatch.Index,
            $NewImport.Trim()
        )
    }
    if (
        $SidebarContent -match `
        '\{\s*Icon\s*\?\s*<Icon\b'
    ) {
        Write-Host "Safe Icon rendering already exists." -ForegroundColor Green
    }
    elseif (
        $SidebarContent -match `
        '<Icon\s+className=["'']h-4 w-4["'']\s*/>'
    ) {
        $SidebarContent = $SidebarContent.Replace(
            '<Icon className="h-4 w-4" />',
            '{Icon ? <Icon className="h-4 w-4" /> : <Palette className="h-4 w-4" />}'
        )
    }
    Set-Content `
        -LiteralPath $SidebarPath `
        -Value $SidebarContent `
        -Encoding UTF8
    Write-Host "LIVE SIDEBAR FIXED" -ForegroundColor Green
    Write-Host ""
    Write-Host "=== PERMANENT TYPESCRIPT EXCLUSIONS ===" -ForegroundColor Cyan
    $TsConfigBackupPath = Join-Path `
        $MovedBackupRoot `
        "tsconfig-before-fix.json"
    Copy-Item `
        -LiteralPath $TsConfigPath `
        -Destination $TsConfigBackupPath `
        -Force
    $NodeFixPath = Join-Path `
        $env:TEMP `
        "knowledge-nest-tsconfig-fix-$Timestamp.cjs"
    @'
const fs = require("node:fs");
const path = require("node:path");
const ts = require("typescript");
const projectRoot = process.argv[2];
const tsconfigPath = path.join(projectRoot, "tsconfig.json");
const raw = fs.readFileSync(tsconfigPath, "utf8");
const parsed = ts.parseConfigFileTextToJson(
  tsconfigPath,
  raw,
);
if (parsed.error) {
  const message = ts.flattenDiagnosticMessageText(
    parsed.error.messageText,
    "\n",
  );
  throw new Error(`Unable to parse tsconfig.json: ${message}`);
}
const config = parsed.config || {};
const permanentExclusions = [
  "node_modules",
  ".next",
  "dist",
  "build",
  "coverage",
  "backups",
  "backups/**/*",
  "logs",
  "logs/**/*",
  "phase-5b-backup",
  "phase-5b-backup/**/*",
  "**/*.backup.ts",
  "**/*.backup.tsx",
];
const currentExclusions = Array.isArray(config.exclude)
  ? config.exclude
  : [];
config.exclude = Array.from(
  new Set([
    ...currentExclusions,
    ...permanentExclusions,
  ]),
);
fs.writeFileSync(
  tsconfigPath,
  `${JSON.stringify(config, null, 2)}\n`,
  "utf8",
);
console.log("Permanent TypeScript exclusions added:");
for (const item of config.exclude) {
  console.log(`- ${item}`);
}
'@ | Set-Content `
        -LiteralPath $NodeFixPath `
        -Encoding UTF8
    node $NodeFixPath $ProjectRoot
    if ($LASTEXITCODE -ne 0) {
        throw "Unable to update tsconfig.json exclusions."
    }
    Remove-Item `
        -LiteralPath $NodeFixPath `
        -Force `
        -ErrorAction SilentlyContinue
    Write-Host ""
    Write-Host "=== MOVE INTERNAL BACKUPS OUTSIDE PROJECT ===" -ForegroundColor Cyan
    $BackupDirectories = @(
        (Join-Path $ProjectRoot "backups"),
        (Join-Path $ProjectRoot "phase-5b-backup")
    )
    foreach ($BackupDirectory in $BackupDirectories) {
        if (Test-Path -LiteralPath $BackupDirectory) {
            $Destination = Join-Path `
                $MovedBackupRoot `
                (Split-Path $BackupDirectory -Leaf)
            Move-Item `
                -LiteralPath $BackupDirectory `
                -Destination $Destination `
