  const message = ts.flattenDiagnosticMessageText(
    parsed.error.messageText,
    "\n",
  );
  throw new Error(`Unable to parse tsconfig.json: ${message}`);
}
const config = parsed.config || {};
const permanentExclusions = [
  "node_modules",
  ".next",
  "dist",
  "build",
  "coverage",
  "backups",
  "backups/**/*",
  "logs",
  "logs/**/*",
  "phase-5b-backup",
  "phase-5b-backup/**/*",
  "**/*.backup.ts",
  "**/*.backup.tsx",
];
const currentExclusions = Array.isArray(config.exclude)
  ? config.exclude
  : [];
config.exclude = Array.from(
  new Set([
    ...currentExclusions,
    ...permanentExclusions,
  ]),
);
fs.writeFileSync(
  tsconfigPath,
  `${JSON.stringify(config, null, 2)}\n`,
  "utf8",
);
console.log("Permanent TypeScript exclusions added:");
for (const item of config.exclude) {
  console.log(`- ${item}`);
}
