const fs = require("node:fs");
const path = require("node:path");
const ts = require("typescript");
const projectRoot = process.argv[2];
const tsconfigPath = path.join(projectRoot, "tsconfig.json");
const raw = fs.readFileSync(tsconfigPath, "utf8");
const parsed = ts.parseConfigFileTextToJson(
  tsconfigPath,
  raw,
);
if (parsed.error) {
  const message = ts.flattenDiagnosticMessageText(
    parsed.error.messageText,
    "\n",
  );
  throw new Error(`Unable to parse tsconfig.json: ${message}`);
}
const config = parsed.config || {};
const permanentExclusions = [
  "node_modules",
  ".next",
  "dist",
  "build",
  "coverage",
  "backups",
  "backups/**/*",
  "logs",
  "logs/**/*",
  "phase-5b-backup",
  "phase-5b-backup/**/*",
  "**/*.backup.ts",
  "**/*.backup.tsx",
];
const currentExclusions = Array.isArray(config.exclude)
  ? config.exclude
  : [];
config.exclude = Array.from(
  new Set([
    ...currentExclusions,
    ...permanentExclusions,
  ]),
);
fs.writeFileSync(
  tsconfigPath,
  `${JSON.stringify(config, null, 2)}\n`,
  "utf8",
);
console.log("Permanent TypeScript exclusions added:");
for (const item of config.exclude) {
  console.log(`- ${item}`);
}
'@ | Set-Content `
        -LiteralPath $NodeFixPath `
        -Encoding UTF8
    node $NodeFixPath $ProjectRoot
    if ($LASTEXITCODE -ne 0) {
        throw "Unable to update tsconfig.json exclusions."
    }
    Remove-Item `
        -LiteralPath $NodeFixPath `
        -Force `
        -ErrorAction SilentlyContinue
    Write-Host ""
    Write-Host "=== MOVE INTERNAL BACKUPS OUTSIDE PROJECT ===" -ForegroundColor Cyan
    $BackupDirectories = @(
        (Join-Path $ProjectRoot "backups"),
        (Join-Path $ProjectRoot "phase-5b-backup")
    )
    foreach ($BackupDirectory in $BackupDirectories) {
        if (Test-Path -LiteralPath $BackupDirectory) {
            $Destination = Join-Path `
                $MovedBackupRoot `
                (Split-Path $BackupDirectory -Leaf)
            Move-Item `
                -LiteralPath $BackupDirectory `
                -Destination $Destination `
                -Force
            Write-Host `
                "Moved: $BackupDirectory -> $Destination" `
                -ForegroundColor Green
        }
    }
    $PackageJson = Get-Content `
        -LiteralPath ".\package.json" `
        -Raw |
        ConvertFrom-Json
    $Scripts = @(
        $PackageJson.scripts.PSObject.Properties.Name
    )
    Invoke-Checked "FORMAT WRITE" {
        if ($Scripts -contains "format") {
            pnpm run format
        }
        else {
            pnpm exec prettier --write .
        }
    }
    Invoke-Checked "FORMAT CHECK" {
        if ($Scripts -contains "format:check") {
            pnpm run format:check
        }
        else {
            pnpm exec prettier --check .
        }
    }
    Invoke-Checked "TYPESCRIPT CHECK" {
        if ($Scripts -contains "typecheck") {
            pnpm run typecheck
        }
        else {
            pnpm exec tsc --noEmit
        }
    }
    Invoke-Checked "ESLINT ZERO WARNINGS" {
        if ($Scripts -contains "lint") {
            pnpm run lint -- --max-warnings=0
        }
        else {
            pnpm exec eslint . --max-warnings=0
        }
    }
    Invoke-Checked "PRODUCTION BUILD" {
        if ($Scripts -contains "build") {
            pnpm run build
        }
        else {
            throw "build script is missing from package.json."
        }
    }
    $RequiredPhase7Files = @(
        "src\lib\theme\types.ts",
        "src\lib\theme\presets.ts",
        "src\lib\theme\theme-store.ts",
        "src\lib\theme\ai-generator.ts",
