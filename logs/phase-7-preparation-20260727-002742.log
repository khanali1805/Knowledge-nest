        ".js",
        ".jsx",
        ".json",
        ".css",
        ".scss",
        ".md",
        ".txt",
        ".mjs",
        ".cjs",
        ".sql",
        ".yaml",
        ".yml"
    )
    $ImportantFiles = @(
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "next.config.ts",
        "next.config.js",
        "drizzle.config.ts",
        "eslint.config.mjs",
        ".prettierrc",
        "README.md"
    )
    $Files = Get-ChildItem `
        -Path $ProjectRoot `
        -Recurse `
        -File `
        -ErrorAction SilentlyContinue |
        Where-Object {
            $_.FullName -notmatch $ExcludedPattern -and
            (
                $AllowedExtensions -contains $_.Extension.ToLowerInvariant() -or
                $ImportantFiles -contains $_.Name
            )
        } |
        Sort-Object FullName
    if (@($Files).Count -eq 0) {
