            [string]$Name,
            [Parameter(Mandatory)]
            [scriptblock]$Command
        )
        Write-Host ""
        Write-Host "=== $Name ===" -ForegroundColor Cyan
        $global:LASTEXITCODE = 0
        & $Command
        if ($LASTEXITCODE -ne 0) {
            throw "$Name failed with exit code $LASTEXITCODE."
        }
        Write-Host "$Name PASSED" -ForegroundColor Green
    }
    if (-not (Test-Path $Phase6Marker)) {
        throw "PHASE-6-COMPLETE.txt is missing."
    }
    $Phase6Status = Get-Content $Phase6Marker -Raw
    if ($Phase6Status -notmatch "PHASE 6 COMPLETE") {
        throw "Phase 6 completion marker is invalid."
    }
    if (-not (Test-Path ".\package.json")) {
        throw "package.json is missing."
    }
    if (-not (Test-Path ".\.env.local")) {
        throw ".env.local is missing."
    }
    $DatabaseLine = Get-Content ".\.env.local" |
        Where-Object { $_ -match '^\s*DATABASE_URL\s*=' } |
        Select-Object -First 1
    if (-not $DatabaseLine) {
        throw "DATABASE_URL is missing from .env.local."
    }
    $DatabaseUrl = ($DatabaseLine -split "=", 2)[1].Trim().Trim('"').Trim("'")
    if (
        [string]::IsNullOrWhiteSpace($DatabaseUrl) -or
        $DatabaseUrl -notmatch '^postgres(ql)?://'
    ) {
        throw "DATABASE_URL is empty or invalid."
    }
    $env:DATABASE_URL = $DatabaseUrl
    $PackageJson = Get-Content ".\package.json" -Raw | ConvertFrom-Json
    $Scripts = @($PackageJson.scripts.PSObject.Properties.Name)
