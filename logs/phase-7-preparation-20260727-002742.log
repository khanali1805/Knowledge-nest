"@
    Set-Content `
        -Path $RoadmapFile `
        -Value $Roadmap `
        -Encoding UTF8
    $ExcludedPattern = '\\node_modules\\|\\\.next\\|\\\.git\\|\\logs\\|\\backups\\|\\phase-5b-backup\\|\\coverage\\|\\dist\\|\\build\\'
    $AllowedExtensions = @(
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".json",
        ".css",
        ".scss",
        ".md",
        ".txt",
        ".mjs",
        ".cjs",
        ".sql",
        ".yaml",
        ".yml"
    )
    $ImportantFiles = @(
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "next.config.ts",
        "next.config.js",
        "drizzle.config.ts",
        "eslint.config.mjs",
        ".prettierrc",
        "README.md"
    )
    $Files = Get-ChildItem `
        -Path $ProjectRoot `
        -Recurse `
        -File `
        -ErrorAction SilentlyContinue |
        Where-Object {
            $_.FullName -notmatch $ExcludedPattern -and
            (
                $AllowedExtensions -contains $_.Extension.ToLowerInvariant() -or
                $ImportantFiles -contains $_.Name
            )
        } |
        Sort-Object FullName
    if (@($Files).Count -eq 0) {
        throw "No project source files were found."
    }
    $Manifest = New-Object System.Collections.Generic.List[string]
    $Manifest.Add("KNOWLEDGE NEST — PHASE 7 TO PHASE 12 FILE MANIFEST")
    $Manifest.Add("Generated: $GeneratedAt")
    $Manifest.Add("Project: $ProjectRoot")
    $Manifest.Add("Total files: $(@($Files).Count)")
    $Manifest.Add("")
    foreach ($File in $Files) {
        $RelativePath = $File.FullName.Substring($ProjectRoot.Length).TrimStart("\")
        $Manifest.Add("$RelativePath | $($File.Length) bytes")
    }
    $Manifest | Set-Content -Path $ManifestFile -Encoding UTF8
    $Output = New-Object System.Collections.Generic.List[string]
    $Output.Add("KNOWLEDGE NEST — PHASE 7 TO PHASE 12 IMPLEMENTATION SOURCE")
    $Output.Add("Generated: $GeneratedAt")
    $Output.Add("Project: $ProjectRoot")
    $Output.Add("")
    $Output.Add($Roadmap)
    $Output.Add("")
    foreach ($File in $Files) {
        $RelativePath = $File.FullName.Substring($ProjectRoot.Length).TrimStart("\")
        $Output.Add("")
        $Output.Add("============================================================")
        $Output.Add("FILE: $RelativePath")
        $Output.Add("============================================================")
        try {
            $Content = Get-Content `
                -LiteralPath $File.FullName `
                -Raw `
                -ErrorAction Stop
            if (
                $RelativePath -match '(?i)\.env' -or
                $RelativePath -match '(?i)secret|credential|token|key'
            ) {
                $SanitisedContent = $Content `
                    -replace '(?m)^([^#\r\n][A-Za-z0-9_]*\s*=\s*).+$', '$1[REDACTED]'
                $Output.Add($SanitisedContent)
            }
            else {
                $Output.Add($Content)
            }
        }
        catch {
            $Output.Add("[UNABLE TO READ FILE: $($_.Exception.Message)]")
        }
    }
    $Output | Set-Content -Path $OutputFile -Encoding UTF8
    $RequiredPhase7Files = @(
        "src\db\index.ts",
        "src\db\schema\index.ts",
        "src\app\layout.tsx",
        "src\app\page.tsx",
        "src\app\admin\layout.tsx",
        "src\app\admin\page.tsx",
        "src\app\admin\settings\page.tsx",
        "src\app\admin\categories\page.tsx",
        "src\components\site\site-header.tsx",
        "src\components\site\site-footer.tsx"
    )
    $MissingPhase7Files = foreach ($RelativePath in $RequiredPhase7Files) {
        if (-not (Test-Path -LiteralPath (Join-Path $ProjectRoot $RelativePath))) {
            $RelativePath
        }
    }
    $SchemaFiles = Get-ChildItem `
        -Path (Join-Path $ProjectRoot "src\db\schema") `
        -File `
        -Filter "*.ts" `
        -ErrorAction SilentlyContinue
    $AdminFiles = Get-ChildItem `
        -Path (Join-Path $ProjectRoot "src\app\admin") `
        -Recurse `
        -File `
        -Include "*.ts","*.tsx" `
        -ErrorAction SilentlyContinue
    $SiteFiles = Get-ChildItem `
        -Path (Join-Path $ProjectRoot "src\components\site") `
        -Recurse `
        -File `
        -Include "*.ts","*.tsx" `
        -ErrorAction SilentlyContinue
    $Phase7References = $Files |
        Where-Object {
            $_.Extension -in @(".ts", ".tsx", ".js", ".jsx", ".md", ".txt")
        } |
        Select-String `
            -Pattern 'theme|preset|niche|homepage builder|drag.{0,5}drop|theme studio|theme version|theme import|theme export' `
            -CaseSensitive:$false `
            -ErrorAction SilentlyContinue
    $Verification = New-Object System.Collections.Generic.List[string]
    $Verification.Add("KNOWLEDGE NEST — PHASE 7 VERIFICATION")
    $Verification.Add("Generated: $GeneratedAt")
    $Verification.Add("Project: $ProjectRoot")
    $Verification.Add("")
    $Verification.Add("Phase 6 prerequisite: PASSED")
    $Verification.Add("Database URL: PASSED")
    $Verification.Add("Project source files: $(@($Files).Count)")
    $Verification.Add("Database schema files: $(@($SchemaFiles).Count)")
    $Verification.Add("Admin source files: $(@($AdminFiles).Count)")
    $Verification.Add("Site component files: $(@($SiteFiles).Count)")
    $Verification.Add("Theme-related references: $(@($Phase7References).Count)")
    $Verification.Add("")
    if ($MissingPhase7Files) {
        $Verification.Add("Missing Phase 7 prerequisite files:")
        foreach ($MissingFile in $MissingPhase7Files) {
            $Verification.Add("- $MissingFile")
        }
    }
    else {
        $Verification.Add("Required Phase 7 prerequisite files: PASSED")
    }
    $Verification.Add("")
    $Verification.Add("PHASE 7 STATUS")
    $Verification.Add("STARTED")
    $Verification.Add("")
    $Verification.Add("REMAINING PHASES")
    $Verification.Add("Phase 7 — AI Theme Engine & Universal Website Builder")
    $Verification.Add("Phase 8 — Advanced Frontend UI/UX")
    $Verification.Add("Phase 9 — AI Content & SEO Automation")
    $Verification.Add("Phase 10 — Advanced CMS")
    $Verification.Add("Phase 11 — Performance & Security")
    $Verification.Add("Phase 12 — Production & Deployment")
    $Verification | Set-Content `
        -Path $VerificationFile `
        -Encoding UTF8
    Set-Content `
        -Path $Phase7StartMarker `
        -Value @"
PHASE 7 STARTED
Started: $GeneratedAt
Verification ID: $Timestamp
Roadmap: $RoadmapFile
Source bundle: $OutputFile
Manifest: $ManifestFile
Verification report: $VerificationFile
Log: $LogPath
"@ `
        -Encoding UTF8
    Remove-Item `
        -Path $Phase7CompleteMarker `
        -Force `
        -ErrorAction SilentlyContinue
