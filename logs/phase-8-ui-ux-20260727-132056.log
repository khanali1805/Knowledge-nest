        </div>
        <nav
          aria-label="Admin navigation"
          className="flex-1 space-y-1.5 overflow-y-auto p-3"
        >
          {navigation.map((item) => {
            const Icon = item.icon;
            const isActive = isNavigationItemActive(pathname, item.href);
            return (
              <Link
                key={item.href}
                href={item.href}
                onClick={onNavigate}
                aria-current={isActive ? "page" : undefined}
                className={[
