} from "lucide-react";
type NavigationItem = {
  href: string;
  label: string;
  description: string;
  icon: LucideIcon;
};
type AdminSidebarProps = Readonly<{
  mobile?: boolean;
  onClose?: () => void;
  onNavigate?: () => void;
}>;
const navigation: NavigationItem[] = [
  {
    href: "/admin",
    label: "Dashboard",
