  {
    href: "/admin/settings",
    label: "Settings",
    description: "Website configuration",
    icon: Settings,
  },
];
function isNavigationItemActive(pathname: string, href: string): boolean {
  if (href === "/admin") {
    return pathname === "/admin";
  }
  return pathname === href || pathname.startsWith(`${href}/`);
}
export function AdminSidebar({
  mobile = false,
