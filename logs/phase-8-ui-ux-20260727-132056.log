@import "tailwindcss";
:root {
  --background: #ffffff;
  --foreground: #171717;
}
@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}
@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}
* {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
}
body {
  min-height: 100vh;
  margin: 0;
  background: var(--theme-background, var(--background));
  color: var(--theme-foreground, var(--foreground));
  font-family: var(--theme-body-font, Arial, Helvetica, sans-serif);
  text-rendering: optimizeLegibility;
}
button,
input,
select,
textarea {
  font: inherit;
}
button,
a {
  -webkit-tap-highlight-color: transparent;
}
a {
  text-underline-offset: 0.2em;
}
img,
svg {
  display: block;
}
h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--theme-heading-font, Arial, Helvetica, sans-serif);
}
::selection {
  background: var(--theme-primary, #2563eb);
  color: var(--theme-background, #ffffff);
}
:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}
.admin-surface {
  --background: #ffffff;
  --foreground: #0f172a;
  --muted: #f1f5f9;
  --muted-foreground: #64748b;
  --border: #e2e8f0;
  --destructive: #dc2626;
  background:
