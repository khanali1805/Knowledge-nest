@import "tailwindcss";
:root {
  --background: #ffffff;
  --foreground: #171717;
}
@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}
@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}
* {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
}
body {
  min-height: 100vh;
  margin: 0;
  background: var(--theme-background, var(--background));
  color: var(--theme-foreground, var(--foreground));
  font-family: var(--theme-body-font, Arial, Helvetica, sans-serif);
  text-rendering: optimizeLegibility;
}
button,
input,
select,
textarea {
  font: inherit;
}
button,
a {
  -webkit-tap-highlight-color: transparent;
}
a {
  text-underline-offset: 0.2em;
}
img,
svg {
  display: block;
}
h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--theme-heading-font, Arial, Helvetica, sans-serif);
}
::selection {
  background: var(--theme-primary, #2563eb);
  color: var(--theme-background, #ffffff);
}
:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}
.admin-surface {
  --background: #ffffff;
  --foreground: #0f172a;
  --muted: #f1f5f9;
  --muted-foreground: #64748b;
  --border: #e2e8f0;
  --destructive: #dc2626;
  background:
    radial-gradient(circle at top right, rgb(15 23 42 / 0.04), transparent 28rem),
    #f8fafc;
  color: var(--foreground);
  font-family: var(--font-geist-sans), Arial, Helvetica, sans-serif;
}
.admin-surface h1,
.admin-surface h2,
.admin-surface h3,
.admin-surface h4,
.admin-surface h5,
.admin-surface h6 {
  font-family: var(--font-geist-sans), Arial, Helvetica, sans-serif;
}
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
'@
    Write-Utf8File -Path $Files.GlobalsCss -Content $GlobalsCssContent
    Invoke-Checked "FORMAT PHASE 8 FILES" {
        pnpm exec prettier `
            --write `
            "src/app/globals.css" `
            "src/app/admin/layout.tsx" `
            "src/app/admin/page.tsx" `
            "src/app/admin/themes/page.tsx" `
            "src/components/admin/admin-shell.tsx" `
            "src/components/admin/admin-header.tsx" `
            "src/components/admin/admin-sidebar.tsx"
    }
    Invoke-Checked "FORMAT CHECK" {
        pnpm exec prettier --check .
    }
    Invoke-Checked "TYPESCRIPT CHECK" {
        pnpm exec tsc --noEmit
    }
    Invoke-Checked "ESLINT ZERO WARNINGS" {
        pnpm exec eslint . --max-warnings=0
