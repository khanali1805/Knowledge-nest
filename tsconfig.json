{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "coverage",
    "backups",
    "backups/**/*",
    "logs",
    "logs/**/*",
    "phase-5b-backup",
    "phase-5b-backup/**/*",
    "**/*.backup.ts",
    "**/*.backup.tsx",
    "**/*.bak.ts",
    "**/*.bak.tsx",
    "phase26-backup",
    "reports",
    "reports/**/*",
    "**/*.backup.*",
    "phase8-final-inspection-20260807-095113"
  ]
}
